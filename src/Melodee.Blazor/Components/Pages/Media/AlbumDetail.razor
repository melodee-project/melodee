    private async Task<Melodee.Common.Data.Models.Library?> ShowLibrarySelectionDialog(
        Melodee.Common.Data.Models.Library[] libraries,
        string message)
    {
        // Use a simple list selection approach with inline component
        var options = libraries.Select(l => $"{l.Name} ({l.Path})").ToArray();
        var libraryDict = libraries.ToDictionary(l => $"{l.Name} ({l.Path})", l => l);

        string? selectedOption = null;

        await DialogService.OpenAsync("Select Destination Library", ds =>
            @<div>
                <RadzenStack Gap="1rem">
                    <RadzenText>@message</RadzenText>
                    <RadzenSelectBar @bind-Value="@selectedOption" TValue="string">
                        <Items>
                            @foreach (var lib in libraries)
                            {
                                var displayText = $"{lib.Name} ({lib.Path})";
                                <RadzenSelectBarItem Text="@displayText" Value="@displayText" />
                            }
                        </Items>
                    </RadzenSelectBar>
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
                        <RadzenButton Text="Cancel" Click="@(() => ds.Close())" ButtonStyle="ButtonStyle.Secondary" />
                        <RadzenButton Text="Select" Click="@(() => ds.Close())" ButtonStyle="ButtonStyle.Primary" Disabled="@(selectedOption == null)" />
                    </RadzenStack>
                </RadzenStack>
            </div>,
            new DialogOptions { Width = "600px", Height = "auto", ShowClose = true });

        return selectedOption != null && libraryDict.ContainsKey(selectedOption)
            ? libraryDict[selectedOption]
            : null;
    }

    private async Task AddSongToJukeboxAsync(Song song)
    {
        try
        {
            Logger.Debug("[AlbumDetail] Adding song to Jukebox queue: {SongId} - {SongTitle}", song.Id, song.Title());

            var result = await SubsonicJukeboxService.AddAsync(CurrentUsersId, [song.Id.ToString()]);

            if (result.IsSuccess)
            {
                Logger.Debug("[AlbumDetail] Successfully added song to Jukebox queue: {SongTitle}", song.Title());
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Added to Jukebox",
                    Detail = $"'{song.Title()}' added to the queue",
                    Duration = ToastTime
                });
            }
            else
            {
                Logger.Warning("[AlbumDetail] Failed to add song to Jukebox queue: {SongTitle}, Messages: {Messages}",
                    song.Title(), string.Join(", ", result.Messages ?? []));
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "Failed to add to Jukebox",
                    Detail = result.Messages?.FirstOrDefault() ?? "Unknown error",
                    Duration = ToastTime
                });
            }
        }
        catch (Exception ex)
        {
            Logger.Error(ex, "[AlbumDetail] Error adding song to Jukebox queue: {SongTitle}", song.Title());
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error",
                Detail = $"Failed to add song to Jukebox: {ex.Message}",
                Duration = ToastTime
            });
        }
    }

