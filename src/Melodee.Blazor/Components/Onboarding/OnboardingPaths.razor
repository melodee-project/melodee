@using Melodee.Blazor.Components.Pages
@using Melodee.Common.Data.Models
@using Melodee.Common.Enums
@using Melodee.Common.Services
@using Melodee.Blazor.Services
@using Melodee.Common.Configuration
@using NodaTime
@inherits MelodeeComponentBase

<RadzenStack Gap="1.5rem">
    <RadzenHeading Level="3" Size="H3" Text="@L("Onboarding.PathsHeading")"/>

    <RadzenText Text="@L("Onboarding.PathsDescription")"/>

    @foreach (var lib in _libraries)
    {
        <RadzenCard>
            <RadzenStack Gap="0.5rem">
                <RadzenText Text="@lib.Name" TextStyle="TextStyle.Subtitle2"/>
                <RadzenFormField Text="@L("Onboarding.PathLabel")">
                    <RadzenTextBox @bind-Value="lib.Path" Style="width: 100%;" Change="@(() => ValidatePath(lib))"/>
                </RadzenFormField>
                @if (!string.IsNullOrEmpty(_pathErrors.GetValueOrDefault(lib.Id)))
                {
                    <RadzenAlert Variant="Variant.Outlined" AlertStyle="AlertStyle.Danger" Icon="error">
                        <RadzenText Text="@_pathErrors.GetValueOrDefault(lib.Id)"/>
                    </RadzenAlert>
                }
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                    <RadzenButton Click="@(() => TestPath(lib))"
                                  Text="@L("Onboarding.TestPath")"
                                  Icon="folder"
                                  ButtonStyle="ButtonStyle.Secondary"
                                  Disabled="@string.IsNullOrEmpty(lib.Path)"/>
                    <RadzenButton Click="@(() => CreateDirectory(lib))"
                                  Text="@L("Onboarding.CreateDirectory")"
                                  Icon="create_new_folder"
                                  ButtonStyle="ButtonStyle.Secondary"/>
                </RadzenStack>
                @if (_pathTestResults.TryGetValue(lib.Id, out var testResult))
                {
                    <RadzenAlert Variant="@(testResult.Exists && testResult.Writable ? Variant.Outlined : Variant.Filled)"
                                 AlertStyle="@(testResult.Exists && testResult.Writable ? AlertStyle.Success : AlertStyle.Warning)"
                                 Icon="@(testResult.Exists && testResult.Writable ? "check_circle" : "warning")">
                        <RadzenText Text="@(testResult.Exists && testResult.Writable ? "Path exists and is writable" : (testResult.Exists ? "Path exists but is not writable" : "Path does not exist"))"/>
                    </RadzenAlert>
                }
            </RadzenStack>
        </RadzenCard>
    }

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="1rem">
        <RadzenButton Click="@Back" Text="@L("Common.Back")" Icon="arrow_back"/>
        <RadzenButton Click="@Next" Text="@L("Common.Next")" Icon="arrow_forward" IsBusy="@_isSaving" Disabled="@_hasErrors"/>
    </RadzenStack>
</RadzenStack>

@code {
    private List<Library> _libraries = new();
    private bool _isSaving;
    private bool _hasErrors;
    private Dictionary<int, string> _pathErrors = new();
    private Dictionary<int, (bool Exists, bool Writable)> _pathTestResults = new();
    private readonly LibraryType[] _requiredTypes = { LibraryType.Inbound, LibraryType.Staging, LibraryType.Storage };

    [Inject] private LibraryService LibraryService { get; set; } = null!;
    [Inject] private OnboardingStateService OnboardingStateService { get; set; } = null!;
    [Inject] private IMelodeeConfigurationFactory ConfigurationFactory { get; set; } = null!;

    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var importData = OnboardingStateService.GetImportData();
        var result = await LibraryService.ListAsync(new PagedRequest { PageSize = short.MaxValue });
        if (result.IsSuccess)
        {
            _libraries = result.Data.Where(l => l.TypeValue is LibraryType.Inbound or LibraryType.Staging or LibraryType.Storage).ToList();
        }

        foreach (var requiredType in _requiredTypes)
        {
            if (!_libraries.Any(l => l.TypeValue == requiredType))
            {
                var defaultPath = GetDefaultPath(requiredType);
                var libName = requiredType.ToString();
                var newLib = new Library
                {
                    Name = libName,
                    Path = defaultPath,
                    Type = (int)requiredType,
                    SortOrder = (int)requiredType,
                    ApiKey = Guid.NewGuid(),
                    CreatedAt = NodaTime.Instant.FromDateTimeUtc(DateTime.UtcNow)
                };
                _libraries.Add(newLib);
            }
        }

        if (importData != null)
        {
            foreach (var lib in _libraries)
            {
                var importedLib = importData.Libraries.FirstOrDefault(l =>
                    l.Name.Equals(lib.Name, StringComparison.OrdinalIgnoreCase) ||
                    l.Type.Equals(lib.TypeValue.ToString(), StringComparison.OrdinalIgnoreCase));
                if (importedLib != null && !string.IsNullOrEmpty(importedLib.Path))
                {
                    lib.Path = importedLib.Path;
                    ValidatePath(lib);
                }
            }
        }
    }

    private static string GetDefaultPath(LibraryType libraryType)
    {
        return libraryType switch
        {
            LibraryType.Inbound => "/app/inbound",
            LibraryType.Staging => "/app/staging",
            LibraryType.Storage => "/app/storage",
            _ => "/app/unknown"
        };
    }

    private void ValidatePath(Library lib)
    {
        var path = lib.Path;
        _pathErrors.Remove(lib.Id);
        _pathTestResults.Remove(lib.Id);
        _hasErrors = false;

        if (string.IsNullOrWhiteSpace(path))
        {
            _pathErrors[lib.Id] = L("Onboarding.PathRequired");
            _hasErrors = true;
            return;
        }

        if (path.Contains("..") || path.Contains("./") || path.Contains(".\\"))
        {
            _pathErrors[lib.Id] = L("Onboarding.PathTraversalInvalid");
            _hasErrors = true;
            return;
        }

        var normalizedPath = Path.GetFullPath(path);
        _pathErrors[lib.Id] = string.Empty;

        foreach (var otherLib in _libraries.Where(l => l.Id != lib.Id))
        {
            if (string.IsNullOrWhiteSpace(otherLib.Path))
            {
                continue;
            }

            var otherNormalizedPath = Path.GetFullPath(otherLib.Path);
            if (PathsOverlap(normalizedPath, otherNormalizedPath))
            {
                _pathErrors[lib.Id] = L("Onboarding.PathOverlap", otherLib.Name);
                _hasErrors = true;
                break;
            }
        }
    }

    private static bool PathsOverlap(string path1, string path2)
    {
        try
        {
            var realPath1 = GetRealPath(path1);
            var realPath2 = GetRealPath(path2);

            if (string.IsNullOrEmpty(realPath1) || string.IsNullOrEmpty(realPath2))
            {
                return false;
            }

            realPath1 = realPath1.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
            realPath2 = realPath2.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);

            if (realPath1.Equals(realPath2, StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }

            if (realPath1.Length > realPath2.Length)
            {
                return realPath1.StartsWith(realPath2 + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase) ||
                       realPath1.StartsWith(realPath2 + Path.AltDirectorySeparatorChar, StringComparison.OrdinalIgnoreCase);
            }

            return realPath2.StartsWith(realPath1 + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase) ||
                   realPath2.StartsWith(realPath1 + Path.AltDirectorySeparatorChar, StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            return false;
        }
    }

    private static string GetRealPath(string path)
    {
        try
        {
            var expandedPath = Environment.ExpandEnvironmentVariables(path);
            var fullPath = Path.GetFullPath(expandedPath);

            if (!Directory.Exists(fullPath) && !File.Exists(fullPath))
            {
                var parent = Path.GetDirectoryName(fullPath);
                while (parent != null && !Directory.Exists(parent))
                {
                    parent = Path.GetDirectoryName(parent);
                }

                if (parent != null)
                {
                    var fileName = Path.GetFileName(fullPath);
                    var combinedPath = Path.Combine(parent, fileName);
                    if (Directory.Exists(combinedPath) || File.Exists(combinedPath))
                    {
                        fullPath = Path.GetFullPath(combinedPath);
                    }
                }
            }

            return Path.GetFullPath(fullPath);
        }
        catch
        {
            return path;
        }
    }

    private void TestPath(Library lib)
    {
        var path = lib.Path;
        if (string.IsNullOrWhiteSpace(path))
        {
            return;
        }

        try
        {
            var resolvedPath = Path.GetFullPath(path);
            var exists = Directory.Exists(resolvedPath);
            var writable = false;

            if (exists)
            {
                try
                {
                    var testFile = Path.Combine(resolvedPath, $".melodee-write-test-{Guid.NewGuid():N}");
                    File.WriteAllText(testFile, "test");
                    File.Delete(testFile);
                    writable = true;
                }
                catch
                {
                    writable = false;
                }
            }

            _pathTestResults[lib.Id] = (exists, writable);
        }
        catch
        {
            _pathTestResults[lib.Id] = (false, false);
        }
    }

    private void CreateDirectory(Library lib)
    {
        var path = lib.Path;
        if (string.IsNullOrWhiteSpace(path))
        {
            return;
        }

        try
        {
            var resolvedPath = Path.GetFullPath(path);
            if (!Directory.Exists(resolvedPath))
            {
                Directory.CreateDirectory(resolvedPath);
            }
            _pathTestResults[lib.Id] = (true, true);
            _pathErrors.Remove(lib.Id);
        }
        catch (Exception ex)
        {
            _pathErrors[lib.Id] = $"Failed to create directory: {ex.Message}";
            _hasErrors = true;
        }
    }

    private async Task Back() => await OnBack.InvokeAsync();

    private async Task Next()
    {
        _hasErrors = false;
        _pathErrors.Clear();

        var paths = _libraries.Where(l => !string.IsNullOrWhiteSpace(l.Path)).Select(l => Path.GetFullPath(l.Path)).ToList();
        for (var i = 0; i < paths.Count; i++)
        {
            for (var j = i + 1; j < paths.Count; j++)
            {
                if (PathsOverlap(paths[i], paths[j]))
                {
                    var lib1 = _libraries.First(l => !string.IsNullOrWhiteSpace(l.Path) && Path.GetFullPath(l.Path) == paths[i]);
                    var lib2 = _libraries.First(l => !string.IsNullOrWhiteSpace(l.Path) && Path.GetFullPath(l.Path) == paths[j]);
                    _pathErrors[lib1.Id] = L("Onboarding.PathOverlap", lib2.Name);
                    _pathErrors[lib2.Id] = L("Onboarding.PathOverlap", lib1.Name);
                    _hasErrors = true;
                }
            }
        }

        if (_hasErrors)
        {
            return;
        }

        _isSaving = true;
        try
        {
            foreach (var lib in _libraries)
            {
                if (lib.Id == 0)
                {
                    var createResult = await LibraryService.CreateAsync(lib, CancellationToken.None);
                    if (!createResult.IsSuccess)
                    {
                        _hasErrors = true;
                        return;
                    }
                }
                else
                {
                    var result = await LibraryService.UpdateAsync(lib, CancellationToken.None);
                    if (!result.IsSuccess)
                    {
                        _hasErrors = true;
                        return;
                    }
                }
            }
            await OnNext.InvokeAsync();
        }
        finally
        {
            _isSaving = false;
        }
    }
}
