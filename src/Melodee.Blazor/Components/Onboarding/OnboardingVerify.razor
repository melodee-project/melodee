@using Melodee.Blazor.Components.Pages
@using Melodee.Common.Services.Setup
@using Melodee.Blazor.Services
@inherits MelodeeComponentBase

<RadzenStack Gap="1.5rem">
    <RadzenHeading Level="3" Size="H3" Text="@L("Onboarding.VerifyHeading")"/>

    <RadzenText Text="@L("Onboarding.VerifyDescription")"/>

    <RadzenButton Click="@RefreshStatus"
                  Text="@L("Onboarding.RefreshStatus")"
                  Icon="refresh"
                  ButtonStyle="ButtonStyle.Secondary"
                  IsBusy="@_isRefreshing"/>

    <RadzenProgressBar Value="@_readyCount" Max="@_totalCount" ShowValue="true" Style="width: 100%;"/>

    <RadzenCard>
        <RadzenStack Gap="0.5rem">
            @foreach (var item in _items)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="@(item.Success ? "check_circle" : "error")"
                                 IconColor="@(item.Success ? Radzen.Colors.Success : Radzen.Colors.Danger)"/>
                    <RadzenText Text="@item.Name"/>
                    <RadzenText Text="@item.Details" TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);"/>
                </RadzenStack>
            }
        </RadzenStack>
    </RadzenCard>

    <RadzenCard>
        <RadzenStack Gap="1rem">
            <RadzenText Text="@L("Onboarding.DownloadChecklist")" TextStyle="TextStyle.Subtitle2"/>
            <RadzenButton Click="@DownloadChecklist"
                          Text="@L("Onboarding.DownloadChecklistButton")"
                          Icon="download"
                          ButtonStyle="ButtonStyle.Secondary"/>
        </RadzenStack>
    </RadzenCard>

    @if (_isReady)
    {
        <RadzenAlert Variant="Variant.Filled" AlertStyle="AlertStyle.Success" Icon="check_circle">
            <RadzenText Text="@L("Onboarding.ReadyToComplete")"/>
        </RadzenAlert>
    }
    else
    {
        <RadzenAlert Variant="Variant.Outlined" AlertStyle="AlertStyle.Warning" Icon="warning">
            <RadzenText Text="@L("Onboarding.BlockingItemsRemaining", _blockingCount)"/>
        </RadzenAlert>
    }

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="1rem">
        <RadzenButton Click="@Back" Text="@L("Common.Back")" Icon="arrow_back"/>
        <RadzenButton Click="@Complete"
                      Text="@L("Onboarding.CompleteSetup")"
                      Icon="check"
                      IsBusy="@_isCompleting"
                      Disabled="@(!_isReady)"/>
    </RadzenStack>
</RadzenStack>

@code {
    private List<SetupItem> _items = new();
    private int _readyCount;
    private int _totalCount;
    private int _blockingCount;
    private bool _isReady;
    private bool _isCompleting;
    private bool _isRefreshing;

    [Inject] private OnboardingStateService OnboardingStateService { get; set; } = null!;
    [Inject] private IJSRuntime JSRuntime { get; set; } = null!;
    [Inject] private ChecklistService ChecklistService { get; set; } = null!;

    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback OnComplete { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await RefreshStatusAsync();
    }

    private async Task RefreshStatus()
    {
        await RefreshStatusAsync();
    }

    private async Task RefreshStatusAsync()
    {
        _isRefreshing = true;
        try
        {
            await OnboardingStateService.RefreshSetupStatusAsync();
            var status = await OnboardingStateService.GetSetupStatusAsync();
            _items = status.Items.ToList();
            _readyCount = _items.Count(i => i.Success);
            _totalCount = _items.Count;
            _blockingCount = status.BlockingItems.Count;
            _isReady = status.IsReady;
        }
        finally
        {
            _isRefreshing = false;
        }
    }

    private async Task Back() => await OnBack.InvokeAsync();

    private async Task Complete()
    {
        _isCompleting = true;
        try
        {
            await OnComplete.InvokeAsync();
        }
        finally
        {
            _isCompleting = false;
        }
    }

    private async Task DownloadChecklist()
    {
        try
        {
            var checklist = await ChecklistService.GenerateChecklistAsync();
            var fileName = L("Onboarding.ChecklistFileName", DateTime.UtcNow);
            var bytes = System.Text.Encoding.UTF8.GetBytes(checklist);
            var base64 = Convert.ToBase64String(bytes);

            await JSRuntime.InvokeVoidAsync("downloadFile", fileName, base64, "text/markdown");
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Failed to generate checklist: {ex.Message}");
        }
    }
}
