@using Melodee.Blazor.Components.Pages
@inherits MelodeeComponentBase

<RadzenStack Gap="1.5rem">
    <RadzenHeading Level="3" Size="H3" Text="@L("Onboarding.WelcomeHeading")"/>

    <RadzenText Text="@L("Onboarding.WelcomeDescription")"/>

    <RadzenCard>
        <RadzenStack Gap="1rem">
            <RadzenText Text="@L("Onboarding.ImportExistingLabel")" TextStyle="TextStyle.Subtitle2"/>
            <RadzenFileInput @bind-Value="@_importFile"
                             ChooseText="@L("Onboarding.ChooseFile")"
                             Accept=".json"
                             MaxFileSize="10485760"
                             Style="width: 100%;"/>

            @if (!string.IsNullOrEmpty(_importMessage))
            {
                <RadzenAlert Variant="Variant.Filled"
                             AlertStyle="@(_importSuccess ? AlertStyle.Success : AlertStyle.Danger)"
                             Icon="@(_importSuccess ? "check_circle" : "error")">
                    <RadzenText Text="@_importMessage"/>
                </RadzenAlert>
            }
        </RadzenStack>
    </RadzenCard>

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="1rem">
        <RadzenButton Click="@Next" Text="@L("Common.Next")" Icon="arrow_forward"/>
    </RadzenStack>
</RadzenStack>

@code {
    private byte[]? _importFile;
#pragma warning disable CS0649
    private string? _importMessage;
    private bool _importSuccess;
#pragma warning restore CS0649

    [Parameter] public EventCallback OnNext { get; set; }

    private async Task Next()
    {
        await OnNext.InvokeAsync();
    }
}
