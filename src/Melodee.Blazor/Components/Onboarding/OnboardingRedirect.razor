@using Melodee.Common.Services.Setup
@inject NavigationManager NavigationManager
@inject OnboardingStateService OnboardingStateService

@code {
    [Parameter] public bool ForceBlocking { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (ForceBlocking)
            {
                NavigationManager.NavigateTo("/onboarding/blocking", forceLoad: true);
                return;
            }

            var blockingItems = await OnboardingStateService.GetBlockingItemsAsync();

            if (blockingItems.Count > 0)
            {
                NavigationManager.NavigateTo("/onboarding/blocking", forceLoad: true);
            }
            else
            {
                NavigationManager.NavigateTo("/onboarding", forceLoad: true);
            }
        }
        catch
        {
            NavigationManager.NavigateTo("/onboarding/blocking", forceLoad: true);
        }
    }
}
